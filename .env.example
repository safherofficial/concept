# Configure in Vercel; do not place real credentials in this file.
SITE_URL=https://your-domain.example
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
STRIPE_AUTOMATIC_TAX=true
# Optional: true allows checkout tests only with a Stripe test key; never enables live checkout.
STRIPE_TEST_CHECKOUT_ENABLED=false
RESEND_API_KEY=
SALES_EMAIL=you@your-domain.example
MAIL_FROM=CONCEPT <hello@your-verified-domain.example>

# Only enable after final legal review and filling all legal placeholders.
LEGAL_TERMS_READY=false
PRIVACY_NOTICE_READY=false
TERMS_VERSION=2026-10-11-v1
